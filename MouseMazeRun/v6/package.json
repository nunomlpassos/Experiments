{
  "name": "mouse-maze-run",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:levels": "node scripts/generate-level-variants.mjs",
    "validate:levels": "node scripts/validate-level-variants.mjs",
    "build": "npm run generate:levels && node scripts/build-web.mjs",
    "android:sync": "npm run build && npx cap sync android",
    "android:debug": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2"
  }
}
